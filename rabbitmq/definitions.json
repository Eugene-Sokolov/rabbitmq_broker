{
  "vhosts": [
    {"name": "/"}
  ],
  "queues": [
    {"name": "payments.new", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {}},
    {"name": "payments.new.retry.1", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {}},
    {"name": "payments.new.retry.2", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {}},
    {"name": "payments.new.dlq", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {}}
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "payments-new",
      "pattern": "^payments\\.new$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "dead-letter-exchange": "",
        "dead-letter-routing-key": "payments.new.dlq"
      }
    },
    {
      "vhost": "/",
      "name": "payments-new-retry-1",
      "pattern": "^payments\\.new\\.retry\\.1$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "message-ttl": 30000,
        "dead-letter-exchange": "",
        "dead-letter-routing-key": "payments.new"
      }
    },
    {
      "vhost": "/",
      "name": "payments-new-retry-2",
      "pattern": "^payments\\.new\\.retry\\.2$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "message-ttl": 300000,
        "dead-letter-exchange": "",
        "dead-letter-routing-key": "payments.new"
      }
    }
  ]
}
